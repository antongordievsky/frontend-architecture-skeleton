{
  // D-04: the stand-in runs on a server (Bun), never in the app, so it compiles against Node's types,
  // without the DOM. It shares only the contract's generated types with the app.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.mock.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    // D-04: `bun` brings Bun.serve, which mock/server.ts is the only caller of. @types/bun 1.4.1 was chosen
    // over 1.4.2 on 2026-09-12 because bun-types' 368 declaration files are byte-identical between the two
    // (measured: only package.json differs), so the aged version needs no quarantine exception (CC-08).
    "types": ["node", "bun"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness — D-22 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["mock"]
}

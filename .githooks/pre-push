#!/bin/sh
# D-25: the backstop before anything leaves the machine: check where the reviewer runs it, in Docker.
set -eu

docker compose build check web
docker compose run --rm check

# D-21: the production form's headers and cache rules, asserted on the built bundle behind Caddy.
docker compose --profile prod up -d --build web-prod
trap 'docker compose --profile prod stop web-prod >/dev/null 2>&1' EXIT
port=${PROD_PORT:-8080}
tries=0
until curl -fsS -o /dev/null "http://localhost:$port/"; do
  tries=$((tries + 1))
  if [ "$tries" -ge 20 ]; then
    echo 'pre-push: web-prod did not answer'
    exit 1
  fi
  sleep 1
done
sh scripts/check-headers.sh "http://localhost:$port"

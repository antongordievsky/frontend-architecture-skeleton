#!/bin/sh
# D-25: the backstop before anything leaves the machine, without Docker — the devbox has none. The
# Docker-dependent gates (check in the pinned image, the browser service, the production header test)
# run in .github/workflows/ci.yml instead (DR-9, amended).
set -eu

# The checks read the working tree, so it must equal HEAD, the commit being pushed.
if ! git diff --quiet HEAD || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo 'pre-push: the working tree differs from HEAD, so the checks would test something other than' >&2
  echo 'what is pushed. Commit or stash the changes, then push.' >&2
  exit 1
fi

# The pinned runtimes live in mise.toml; git may start this hook without mise's shell hook on the PATH.
run() {
  if command -v mise >/dev/null 2>&1; then mise exec -- "$@"; else "$@"; fi
}

# Nothing is staged at push time, so a directory-wide scan replaces pre-commit's staged one.
run betterleaks dir --redact --no-banner .

# Plan 05a noted and left open: a merge, rebase or cherry-pick never runs pre-commit, so nothing checks
# what it brought into bun.lock. --all checks every locked version, whatever wrote it, closing that gap.
# Node's fetch needs NODE_USE_ENV_PROXY=1 behind the agent's sandbox proxy; elsewhere it changes nothing.
run env NODE_USE_ENV_PROXY=1 node scripts/check-lockfile-age.mjs --all

run bun run check

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git check-ignore*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git merge --ff-only *)"
    ],
    "ask": [
      "Bash(bun add*)",
      "Bash(bun remove*)",
      "Bash(bun update*)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(npx *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm update*)",
      "Bash(pnpm add*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(git push*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git rebase*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf .git*)",
      "Bash(docker compose down -v*)",
      "Bash(docker system prune*)"
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git check-ignore*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git merge --ff-only *)",
      "Bash(mise exec -- bun run check)",
      "Bash(mise exec -- bun run typecheck)",
      "Bash(mise exec -- bun run build)",
      "Bash(mise exec -- bun run lint)",
      "Bash(mise exec -- bun run format)",
      "Bash(mise exec -- bun run graph:build)",
      "Bash(mise exec -- bun run graph:update)",
      "Bash(mise exec -- bun install --frozen-lockfile)",
      "Bash(bun run check)",
      "Bash(bun run typecheck)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run graph:build)",
      "Bash(bun run graph:update)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(sh scripts/check-headers.sh*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(docker compose --profile prod up*)",
      "Bash(docker compose --profile prod build*)",
      "Bash(docker compose --profile prod stop*)",
      "Bash(docker compose run --rm check)",
      "Bash(docker compose stop*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "mcp__codegraph",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_navigate_forward",
      "mcp__playwright__browser_reload",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_press_sequentially",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_check",
      "mcp__playwright__browser_uncheck",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_verify_element_visible",
      "mcp__playwright__browser_verify_text_visible",
      "mcp__playwright__browser_verify_list_visible",
      "mcp__playwright__browser_verify_value"
    ],
    "ask": [
      "Bash(mise exec -- bun add*)",
      "Bash(mise exec -- bun remove*)",
      "Bash(mise exec -- bun update*)",
      "Bash(mise exec -- bun x *)",
      "Bash(mise exec -- bunx *)",
      "Bash(mise exec -- npx *)",
      "Bash(mise x *)",
      "Bash(mise use*)",
      "Bash(mise install*)",
      "Bash(bun create*)",
      "Bash(bun pm trust*)",
      "Bash(bun add*)",
      "Bash(bun remove*)",
      "Bash(bun update*)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(npx *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm update*)",
      "Bash(pnpm add*)",
      "Bash(pnpm update*)",
      "Bash(pnpm dlx*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(cat .env*)",
      "Bash(git diff --no-index*)",
      "Bash(git push*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git rebase*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -rf .git*)",
      "Bash(docker compose down -v*)",
      "Bash(docker system prune*)",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": ["docker"],
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "./.env", "./.env.*"],
      "allowWrite": [
        "~/.bun",
        "~/.cache",
        "~/.local/share/mise",
        "~/.local/state/mise",
        "~/.docker"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "localhost"
      ]
    }
  }
}

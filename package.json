{
  "name": "tallyfolio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "check": "bun run typecheck && vite build --outDir node_modules/.cache/check-build",
    "lint": "oxlint",
    "preview": "vite preview",
    "graph:build": "codegraph build --no-incremental",
    "graph:update": "codegraph build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@optave/codegraph": "3.17.0",
    "@playwright/mcp": "0.0.80",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "^1.81.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0"
  }
}

{
  "name": "tallyfolio-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate": "orval --config orval.config.ts",
    "routes": "tsr generate",
    "check": "biome ci && bun run lint && sh scripts/check-contract.sh && sh scripts/check-routes.sh && bun run typecheck && vitest run && vite build --outDir node_modules/.cache/check-build && betterleaks dir --redact --no-banner . && bun audit",
    "format": "biome format --write",
    "lint": "oxlint --deny-warnings && node lint/layers.test.mjs",
    "preview": "vite preview",
    "prepare": "sh scripts/enable-hooks.sh",
    "graph:build": "codegraph build --no-incremental",
    "graph:update": "codegraph build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@biomejs/biome": "2.5.12",
    "@optave/codegraph": "3.17.0",
    "@playwright/mcp": "0.0.80",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/router-cli": "1.167.33",
    "@tanstack/router-plugin": "1.168.35",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "orval": "8.31.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "trustedDependencies": [
    "!none"
  ]
}

# D-12: the production form. Static bundle, client-route fallback, compression, long cache for
# hashed assets, security headers (D-21). scripts/check-headers.sh asserts all of it; pre-push runs it.
{
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Only a hashed file that exists is cached for a year. A missing one answers 404: falling back to
	# index.html would let the browser keep HTML under a script URL, immutable, for a year.
	@hashed {
		path /assets/*
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@entry not path /assets/*
	header @entry Cache-Control "no-cache"

	# D-21: scripts, styles and requests only from this origin; the built index.html has nothing inline.
	# Widening it (fonts, Sentry) names the source here and in scripts/check-headers.sh together.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
